<Window x:Class="EasySaveWPFApp.UnsavedFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:EasySaveWPFApp.Resources" xmlns:model1="clr-namespace:EasySaveWPFApp.Model"
        Title="{x:Static p:Resources.UnsavedFilesWindow_WindowTitle}" Height="400" Width="600" WindowStartupLocation="CenterOwner">
    <Grid>
        <TextBlock Text="{x:Static p:Resources.UnsavedFilesWindow_Title}" 
                   FontSize="16" FontWeight="Bold" 
                   Margin="10" HorizontalAlignment="Left"/>

        <ListView Name="UnsavedFilesList" Margin="10,40,10,50" ItemsSource="{Binding UnsavedFiles}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{x:Static p:Resources.UnsavedFilesWindow_NomDeSaveTaskColumnTitle}" Width="150" DisplayMemberBinding="{Binding Key}"/>
                    <GridViewColumn Header="{x:Static p:Resources.UnsavedFilesWindow_PathsColumnTitle}" Width="350">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Value}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Bouton pour fermer la fenêtre -->
        <Button Content="Close" Width="100" Height="30" VerticalAlignment="Bottom" 
                HorizontalAlignment="Right" Margin="10" Click="CloseButton_Click"/>
    </Grid>
</Window>



