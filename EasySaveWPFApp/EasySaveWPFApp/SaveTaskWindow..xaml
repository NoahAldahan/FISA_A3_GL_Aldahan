<Window x:Class="EasySaveWPFApp.SaveTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SaveTask" Height="368" Width="500">
    <Grid Margin="0,0,0,2">
        <TextBlock Text="Nom" VerticalAlignment="Top" Margin="22,34,-2,0"/>
        <TextBox Name="TaskName" VerticalAlignment="Top" Margin="20,55,20,0" TextChanged="TaskName_TextChanged"/>

        <TextBlock Text="SOURCE" VerticalAlignment="Top" Margin="20,95,0,0"/>
        <TextBox Name="TaskSource" VerticalAlignment="Top" Margin="20,115,20,0"/>

        <TextBlock Text="DESTINATION" VerticalAlignment="Top" Margin="20,155,0,0"/>
        <TextBox Name="TaskDestination" VerticalAlignment="Top" Margin="20,175,20,0"/>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="22,224,-2,0">
            <RadioButton Name="DifferentialRadioButton" Content="Différentiel" Margin="0,0,20,0"/>
            <RadioButton Name="CompleteRadioButton" Content="Complète"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
            <Button Content="Enregistrer" Width="100" Height="30" Margin="10" Click="SaveButton_Click"/>
            <Button Content="Annuler" Width="100" Height="30" Margin="10" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
