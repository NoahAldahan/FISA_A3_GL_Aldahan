<Window x:Class="EasySaveWPFApp.SaveTaskProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasySaveWPFApp" xmlns:viewmodel="clr-namespace:EasySaveWPFApp.ViewModel" 
        d:DataContext="{d:DesignInstance Type=viewmodel:SaveTaskProgressViewModel}"
        xmlns:p="clr-namespace:EasySaveWPFApp.Resources" xmlns:model1="clr-namespace:EasySaveWPFApp.Model"
        mc:Ignorable="d"
        Title="{x:Static p:Resources.SaveTaskProgress_Title}" Height="348" Width="521">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static p:Resources.SaveTaskProgress_Title}" FontWeight="Bold" Margin="10"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding BindSaveTasksCurrentlySaving}" Name="ProgressTable" AutoGenerateColumns="False" Margin="10" IsReadOnly="True" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static p:Resources.MainWindow_NameColumnTitle}" Binding="{Binding BindName}" Width="*"/>
                <DataGridTemplateColumn Header="Progress" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ProgressBar Width="150" Height="20" Value="{Binding BindSaveTaskProgressPercentage}" Maximum="100"/>
                                <TextBlock Text="{Binding BindSaveTaskProgressPercentage, StringFormat='{}{0}%'}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{x:Static p:Resources.SaveTaskProgress_StateColumnTitle}" Binding="{Binding BindState}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="{x:Static p:Resources.SaveTaskProgress_PlaySelectedButton}" Width="100" Margin="5" Click="PlaySelected_Click"/>
            <Button Content="{x:Static p:Resources.SaveTaskProgress_PauseSelectedButton}" Width="100" Margin="5" Click="PauseSelected_Click"/>
            <Button Content="{x:Static p:Resources.SaveTaskProgress_StopSelectedButton}" Width="100" Margin="5" Click="StopSelected_Click"/>
        </StackPanel>
    </Grid>
</Window>
