<Window x:Class="EasySaveWPFApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:EasySaveWPFApp.Resources"
        Title="Settings" Height="480" Width="480">

    <Grid RenderTransformOrigin="0.5,0.532">
        <TextBlock Text="{x:Static p:Resources.SettingsMenu_Title}" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"/>

        <!-- Format Log -->
        <TextBlock Text="{x:Static p:Resources.SettingsMenu_LogFormatText}" Margin="10,40,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <RadioButton x:Name="JSONRadioButton" Content="{x:Static p:Resources.SettingsMenu_JsonRadioButtonText}" Margin="10,60,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Checked="JSONRadioButton_Checked"/>
        <RadioButton x:Name="XMLRadioButton" Content="{x:Static p:Resources.SettingsMenu_XmlRadioButtonText}" Margin="100,60,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Checked="XMLRadioButton_Checked"/>

        <!-- Extensions à crypter -->
        <TextBlock Text="{x:Static p:Resources.SettingsMenu_EncryptingExtensionText}" Margin="10,90,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <StackPanel x:Name="EncryptingExtensionsStackPanel" Orientation="Horizontal" Margin="10,110,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>


        <!-- Ajouter une extension à crypter -->
        <TextBlock Text="{x:Static p:Resources.SettingsMenu_EnterEncryptingExtensionPromptText}" Margin="10,150,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <StackPanel Orientation="Horizontal" Margin="10,172,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="36" Width="324">
            <TextBox x:Name="EncryptingExtensionTextBox" Width="200" RenderTransformOrigin="0.457,-4.341" Height="28" />
            <Button Content="{x:Static p:Resources.SettingsMenu_EncryptingExtensionsValidateButtonText}" Width="57" Click="ValidateEncryptingExtensionButton" Height="20" Margin="20,0,0,0"/>
        </StackPanel>

        <!-- Extensions prioritaires -->
        <TextBlock Text="{x:Static p:Resources.SettingsMenu_PriorityExtensionText}" Margin="10,242,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <StackPanel x:Name="PriorityExtensionsStackPanel" Orientation="Horizontal" Margin="10,262,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>


        <!-- Ajouter une extension prioritaire -->
        <TextBlock Text="{x:Static p:Resources.SettingsMenu_EnterPriorityExtensionPromptText}" Margin="10,302,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <StackPanel Orientation="Horizontal" Margin="10,324,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="36" Width="324">
            <TextBox x:Name="PriorityExtensionTextBox" Width="200" RenderTransformOrigin="0.457,-4.341" Height="28" />
            <Button Content="{x:Static p:Resources.SettingsMenu_PriorityExtensionsValidateButtonText}" Width="57" Click="ValidatePriorityExtensionButton" Height="20" Margin="20,0,0,0"/>
        </StackPanel>


        <!-- Sélection de langue -->
        <TextBlock Text="{x:Static p:Resources.SettingsMenu_LanguageText}" Margin="10,382,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <StackPanel Orientation="Horizontal" Margin="10,402,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <RadioButton x:Name="FrenchRadioButton" Content="{x:Static p:Resources.SettingsMenu_FrenchButtonText}" Margin="10,10,0,10" HorizontalAlignment="Left" VerticalAlignment="Top" Checked="FrenchLanguageRadioButton_Checked"/>
            <RadioButton x:Name="EnglishRadioButton" Content="{x:Static p:Resources.SettingsMenu_EnglishButtonText}" Margin="50,10,10,0" HorizontalAlignment="Left" VerticalAlignment="Top" Checked="EnglishLanguageRadioButton_Checked"/>
        </StackPanel>

        <!-- Boutons Cancel & Save -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10">
            <Button Content="{x:Static p:Resources.SettingsMenu_CancelButtonText}" Width="100" Click="Cancel_Click"/>
            <Button Content="{x:Static p:Resources.SettingsMenu_SaveButtonText}" Width="100" Margin="10,0,0,0" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>