package "logDLL"{


    abstract class Log <<abstract>>{
    +string LogRealTimePath
    +string LogDailyPath
    +Log(string LogDailyPath, string LogRealTimePath)
    }


    class JsonLogManager {
    + static void UpdateRealTimeProgression(RealTimeInfo realTimeInfo, string LogRealTimePath)
    + static void CreateRepertories(string path)
    + static string GetFileDailyName(DateTime Date, string LogDailyPath)
    + static string GetFileRealTimeName(string LogRealTimePath)
    + static void CreateDailyJsonFile(DateTime Date, string LogDailyPath)
    + static void CreateRealTimeJsonFile(string LogRealTimePath)
    + static DateTime GetLastSaveDateFromJson(string LogDailyPath, string FilePath)
    + static void AddJsonLogObjectRealTime(string FilePath, RealTimeInfo realTimeInfo)
    + static void AddJsonLogObjectDailyInfo(string FilePath, DailyInfo dailyInfo)
}

        ' Déclaration de la classe LogDaily

    class LogDaily {
    - DailyInfo dailyInfo
    - Stopwatch stopWatch
    + LogDaily(string LogDailyPath, string LogRealTimePath)
    + void CreateDailyFile(int logType = 0)
    + void AddDailyInfo(string saveTaskName, string SourcePath, string TargetPath, long encryptionTime, int logType = 0)
}

class LogRealTime {
    - realTimeInfo : RealTimeInfo
    + CreateRealTimeInfo(saveTaskName: string, SourcePath: string, TargetPath: string, state: ERealTimeState, saveTaskType: int, logType: int) : void
    + GetTotalFilesInfosToCopy(path: string, saveTaskType: int) : Tuple<int, int>
    + UpdateRealTimeProgress(state: string, logType: int) : void
    + GetTotalFilesLeftToDo() : int
}


    struct DailyInfo {
    - Name : string
    - FileSource : string
    - FileTarget : string
    - FileSize : long
    - FileTransferTime : double
    - EncryptionTimeMs : long
    - DateTime : DateTime
    + ToString() : string
}

    
    class AsyncFileManager {
        - int MaxRetries
        - int RetryDelay
        - object WriteFileLock
        - object ReadFileLock
        - object SerializeLock

        + LockedReadAllText(string filePath) : string
        + LockedWriteAllText(string filePath, string content) : void
        + LockedSerialize<T>(T obj) : string
        + LockedDeserialize<T>(string jsonContent) : T
}

    class XmlLogManager {
        - int MaxRetries
        - int RetryDelay
        - object WriteFileLock
        - object ReadFileLock
        - object SerializeLock

        + UpdateRealTimeProgression(RealTimeInfo realTimeInfo, string LogRealTimePath) : void
        + CreateRepertories(string path) : void
        + GetFileDailyName(DateTime Date, string LogDailyPath) : string
        + GetFileRealTimeName(string LogRealTimePath) : string
        + CreateDailyXmlFile(DateTime Date, string LogDailyPath) : void
        + CreateRealTimeXmlFile(string LogRealTimePath) : void
        + AddSaveToDailyFile(DailyInfo dailyInfo, string LogDailyPath) : void
        + AddSaveToRealTimeFile(RealTimeInfo realTimeInfo, string LogRealTimePath) : void
        + AddXmlLogObject<T>(string FilePath, T LogObject) : void
        - SerializeXml<T>(string filePath, T data) : void
        - DeserializeXml<T>(string filePath) : T
        + GetLastSaveDateFromXml(string LogDailyPath, string FilePath) : DateTime
    }

    enum ERealTimeState <<enum>> {
    PAUSED
    ACTIVE
    STOPPED
    END 
    ERROR 
    WAITING_FOR_PRIORITY_FILES
}

    class ERealTimeStateExstensions {
    - MessageStrings : Dictionary<ERealTimeState, string>
    + GetValue(message: ERealTimeState) : string
}





    LogDaily --|> Log
    LogRealTime --|> Log
    LogRealTime ..> RealTimeInfo : "<<Compose>>"
    LogDaily ..> DailyInfo : "<<Compose>>"
    LogRealTime --> JsonLogManager : "<<uses>>"
    LogDaily --> JsonLogManager : "<<uses>>"
    SaveTaskFactory --> LogRealTime : "<<creates>>"
    SaveTaskFactory --> LogDaily : "<<creates>>"
    SaveTask o--> LogDaily : "<<uses>>"
    SaveTask o--> LogRealTime : "<<uses>>"
    SaveTask --> LogUtilities : "<<uses>>"
    SettingsViewModel --> LogUtilities : "<<uses>>"
    LogUtilities --> ELogFormat : "<<creates>>"
    SaveTaskProgressWindow *--> SaveTaskProgressViewModel : "<<instanciates>>"
    JsonManager --> AsyncFileManager : "<<uses>>"
    JsonLogManager  --> AsyncFileManager : "<<uses>>"
    XmlLogManager --> AsyncFileManager : "<<uses>>"
    RealTimeInfo --> ERealTimeStateExstensions : "<<uses>>"
    ERealTimeStateExstensions --> ERealTimeState : "<<uses>>"
    LogRealTime --> ERealTimeState : "<<uses>>"
}

@enduml