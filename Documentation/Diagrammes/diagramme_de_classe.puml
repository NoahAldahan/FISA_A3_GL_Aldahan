@startuml

/' ==================== Packages ==================== '/
package "Model" {

class SaveTaskFactory {
    - LogRealTime logRealTime
    - LogDaily logDaily
    
    + CreateSave(ESaveTaskTypes saveTaskTypes, string sourcePath, string targetPath, string saveTaskName) : SaveTask
}

abstract class SaveTask <<abstract>> {
    - CancellationTokenSource cancellationTokenSource
    - ManualResetEventSlim pauseEvent
    - DirectoryPair CurrentDirectoryPair
    - bool isSoftwareRunning
    - bool IsSaveSuccessful
    - float SaveTaskProgressPercentage
    - LogRealTime logRealTime
    - LogDaily logDaily
    - List<string> UnsavedPaths
    - int nFilesUnsavedCancelled
    - string name
    - ERealTimeState state
    + string BindName
    + string BindState
    + float BindSaveTaskProgressPercentage
    + string BindSource
    + string BindDestination
    + ESaveTaskTypes BindSaveTaskType
    
    + SetBindState(ERealTimeState state)
    + SetLogRealTime(LogRealTime logRealTime)
    + SetLogDaily(LogDaily logDaily)
    + GetUnsavedPaths() : List<string>
    + GetDirectoryPair() : DirectoryPair
    + GetSaveTaskType() : ESaveTaskTypes
    + Save(SaveTaskManager saveTaskManager) : bool
    + ExecuteSaveAsync(SaveTaskManager saveTaskManager) : Task<bool>
    + CopySingleFile(sourcePath, targetPath, saveTaskManager)
    + UpdateProgress()
    + CreateDirectory(directoryPath)
    + NotifySoftwareRunning(isSoftwareRunning)
    + Pause()
    + Play()
    + Stop()
    - OnPropertyChanged(propertyName)
    
    # PropertyChanged : event PropertyChangedEventHandler?
}



class SaveTaskDifferential {
    - List<string> UnsavedPaths
    - int nFilesUnsavedCancelled
    
    + Save(SaveTaskManager saveTaskManager) : bool
    + SaveDifferentialRecursive(SourcePath, TargetPath, saveTaskManager) : List<string>
    + GetSaveTaskType() : ESaveTaskTypes
}

class SaveTaskComplete {
    - List<string> UnsavedPaths
    - bool isSoftwareRunning
    
    + Save(SaveTaskManager saveTaskManager) : bool
    + SaveComplete(SaveTaskManager saveTaskManager) : List<string>
    + CopyFilesRecursivelyForTwoFolders(sourceDirectoryInfo, targetDirectoryInfo, saveTaskManager) : List<string>
    + GetSaveTaskType() : ESaveTaskTypes
}


class DirectoryPair {
    - string SourcePath
    - string TargetPath
    
    + DirectoryPair(SourcePath, TargetPath)
    + DirectoryPair(dp)
}


    enum ESaveTaskTypes <<enum>> {
        Differential
        Complete
        Unknown
    }

    class ESaveTaskTypesExtension {
        {static} + Dictionary<ESaveTaskTypes, String> SaveTaskTypesStrings
        --
        {static} + List<String> GetAllStrSaveTasksType()
        {static} + ESaveTaskTypes ToESaveTaskTypes(String ESaveTaskTypesStr)
    }

class SaveTaskManager {
    - ObservableCollection<SaveTask> SaveTasks
    - SaveTaskFactory SaveTaskFactory
    - Dictionary<string, List<string>> CurrentUnsavedPathsLists
    - List<string> EncryptingExtensions
    - List<string> PriorityExtensions
    - ProcessMonitor processMonitor
    - bool isSoftwareRunning

    + List<string> GetEncryptingExtensions()
    + List<string> GetPriorityExtensions()
    + List<SaveTask> GetSaveTasksClone()
    + bool IsSaveTaskNameExist(name: string)
    + SaveTask? GetSaveTaskByName(name: string)
    + bool AddSaveTask(SaveTaskType: ESaveTaskTypes, sourcePath: string, targetPath: string, saveTaskName: string)
    + bool RemoveSaveTask(name: string)
    + Task<bool> ExecuteSaveTaskAsync(name: string)
    + void ClearUnsavedPathsLists()
    + bool ModifySaveTaskType(name: string, newSaveTaskType: ESaveTaskTypes)
    + bool ModifySaveTaskSourcePath(name: string, newSourcePath: string)
    + bool ModifySaveTaskTargetPath(name: string, newTargetPath: string)
    + bool ModifySaveTaskName(name: string, newName: string)
    + bool SwitchSaveTask(name: string)
    + void SerializeSaveTasks()
    + void SetEncryptingExtensions(newEncryptingExtensions: List<string>)
    + void SerializeEncryptingExtensions()
    + void DeserializeEncryptingExtensions()
    + void SetPriorityExtensions(newPriorityExtensions: List<string>)
    + void SerializePriorityExtensions()
    + void DeserializePriorityExtensions()
    + event PropertyChangedEventHandler PropertyChanged
}

interface ESaveTaskObserver {
    +void NotifySoftwareRunning(bool isSoftwareRunning)
}


class ProcessMonitor {
    - System.Timers.Timer timer
    - const string businessSoftware
    - bool isSoftwareRunning
    
    + event Action<bool> OnSoftwareStatusChanged
    + ProcessMonitor()
    + void Stop()
    - Task CheckBusinessSoftware()
}

class JsonManager {
    {static} - string AppSettingsPath
    {static} - string SaveTaskSerializationPath
    {static} - string LogPathDaily
    {static} - string LogPathRealTime
    {static} - string EncryptingExtensionsSerializationPath
    {static} - string PriorityExtensionsSerializationPath
    {static} - string EncryptionKey
    
    {static} + string GetSettings(string settings)
