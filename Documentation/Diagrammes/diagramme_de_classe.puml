    {static} + List<SaveTask> DeserializeSaveTasks()
    {static} + void SerializeEncryptingExtensions(List<string> EncryptingExtensions)
    {static} + List<string> DeserializeEncryptingExtensions()
    {static} + void SerializePriorityExtensions(List<string> PriorityExtensions)
    {static} + List<string> DeserializePriorityExtensions()
}

class Utilities {
    {static} + bool IsValidPath(string path)
}


